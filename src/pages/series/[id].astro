---
/**
 * EN series page — /series/<id>/ (2026-10-18): intro + ordered episode list. The episode list is built
 * from the Chinese entries (the series' source of truth); each links to its English version when one is
 * published, otherwise to the Chinese page with a 中文 badge.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SERIES, seriesStatusEn } from '../../data/series';
import { postSlug } from '../../data/slug';

export async function getStaticPaths() {
  const zh = await getCollection('writing', (e) => e.data.lang === 'zh' && !e.data.draft && e.data.series);
  const en = await getCollection('writing', (e) => e.data.lang === 'en' && !e.data.draft);
  const enBySlug = new Map(en.map((p) => [postSlug(p), p]));
  return SERIES.map((s) => ({
    params: { id: s.id },
    props: {
      meta: s,
      eps: zh
        .filter((p) => p.data.series === s.id)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
        .map((p) => {
          const e = enBySlug.get(postSlug(p));
          return {
            order: p.data.seriesOrder,
            date: p.data.date,
            title: e ? e.data.title : p.data.title,
            href: e ? `/writing/${postSlug(p)}/` : `/zh/writing/${postSlug(p)}/`,
            zhOnly: !e,
          };
        }),
    },
  }));
}

const { meta, eps } = Astro.props;
---

<Base title={`${meta.titleEn ?? meta.title} — Series — 时间观察者`} description={meta.descriptionEn ?? meta.description} lang="en" altHref={`/zh/series/${meta.id}/`}>
  <main class="mx-auto max-w-2xl px-6 py-12">
    <p class="text-sm text-muted"><a href="/series/" class="hover:text-ink">Series</a></p>
    <h1 class="mt-2 text-3xl font-semibold text-chalk">{meta.titleEn ?? meta.title}</h1>
    <p class="mt-3 flex items-center gap-3">
      <span class:list={['rounded border px-1.5 py-0.5 text-xs', meta.status === '连载中' ? 'border-accent-soft/60 text-accent-soft' : 'border-line text-muted']}>{seriesStatusEn(meta.status)}</span>
      <span class="text-sm text-muted">{eps.length} essays</span>
    </p>
    <p class="mt-4 leading-relaxed text-muted">{meta.descriptionEn ?? meta.description}</p>
    {meta.noteEn && <p class="mt-2 text-sm text-faint">{meta.noteEn}</p>}
    <ol class="mt-8 space-y-3">
      {
        eps.map((e) => (
          <li>
            <a href={e.href} class="group flex items-baseline gap-4 rounded-lg border border-line/70 bg-surface/40 p-4 transition-colors hover:border-accent-soft/60 hover:bg-surface">
              <span class="shrink-0 font-mono text-sm text-faint">{String(e.order).padStart(2, '0')}</span>
              <span class="flex-1">
                <span class="font-medium text-ink group-hover:text-chalk">{e.title}</span>
                <time class="mt-1 block text-xs text-faint" datetime={e.date.toISOString().slice(0, 10)}>{e.date.toISOString().slice(0, 10)}</time>
              </span>
              {e.zhOnly && <span class="shrink-0 rounded border border-line px-1.5 py-0.5 text-xs text-muted">中文</span>}
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>
