---
/**
 * EN series index — /series/ (2026-10-18). Mirror of /zh/series/: the registry in src/data/series.ts
 * plus frontmatter. Before this page existed, the series link on every English article (Post.astro
 * seriesHref = /series/<id>/) fell through to the home page.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SERIES, seriesStatusEn } from '../../data/series';

const posts = await getCollection('writing', (e) => e.data.lang === 'zh' && !e.data.draft && e.data.series);
const count = new Map<string, number>();
for (const p of posts) count.set(p.data.series!, (count.get(p.data.series!) ?? 0) + 1);
---

<Base
  title="Series — 时间观察者"
  description="Science-history essays in series: Symmetry and the Monster, Euler, and more."
  lang="en"
  altHref="/zh/series/"
>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-semibold text-chalk">Series</h1>
    <p class="mt-2 text-muted">Long-form essays, published episode by episode.</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        SERIES.map((s) => (
          <a href={`/series/${s.id}/`} class="block rounded-lg border border-line/70 bg-surface/40 p-6 transition-colors hover:border-accent-soft/60 hover:bg-surface">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-xl font-semibold text-chalk">{s.titleEn ?? s.title}</h2>
              <span class:list={['shrink-0 rounded border px-1.5 py-0.5 text-xs', s.status === '连载中' ? 'border-accent-soft/60 text-accent-soft' : 'border-line text-muted']}>{seriesStatusEn(s.status)}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.descriptionEn ?? s.description}</p>
            <p class="mt-4 text-xs text-faint">{count.get(s.id) ?? 0} essays{s.noteEn ? ' · ' + s.noteEn : ''}</p>
          </a>
        ))
      }
    </div>
  </main>
</Base>
