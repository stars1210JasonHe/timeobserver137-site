---
/**
 * English article route (added 2026-10-16). Mirrors /zh/writing/[slug].astro for entries
 * under content/writing/en/. The language switcher points at the Chinese original
 * (same slug, see src/data/translations.ts).
 */
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { seriesById } from '../../data/series';
import { postSlug } from '../../data/slug';
import { publishedSlugs } from '../../data/translations';

export async function getStaticPaths() {
  // drafts are never built here; they build under /preview/ (see src/pages/preview/)
  const posts = await getCollection('writing', (e) => e.data.lang === 'en' && (import.meta.env.DEV || !e.data.draft));
  return posts.map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry, all: posts },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const slug = postSlug(entry);
const zh = await publishedSlugs('zh');

let seriesCtx = null;
if (d.series) {
  const meta = seriesById(d.series);
  const eps = all
    .filter((p) => p.data.series === d.series && !p.data.draft)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  const idx = eps.findIndex((p) => p.id === entry.id);
  const link = (p) => `/writing/${postSlug(p)}/`;
  seriesCtx = meta && {
    id: d.series,
    title: meta.titleEn ?? meta.title,
    order: d.seriesOrder,
    total: eps.length,
    prev: idx > 0 ? { title: eps[idx - 1].data.title, href: link(eps[idx - 1]) } : null,
    next: idx >= 0 && idx < eps.length - 1 ? { title: eps[idx + 1].data.title, href: link(eps[idx + 1]) } : null,
  };
}
---

<Post
  title={d.title}
  description={d.excerpt ?? `${d.title} — timeobserver137`}
  lang="en"
  altHref={zh.has(slug) ? `/zh/writing/${slug}/` : '/zh/writing/'}
  date={d.date}
  tags={d.tags}
  ogImage={d.cover}
  series={seriesCtx}
>
  <Content />
</Post>
