---
/**
 * EN writing index. Since 2026-10-16 essays get English versions (src/data/translations.ts):
 * an essay with a published English version is listed in English and links to /writing/<slug>/;
 * one without is still listed by its Chinese card, with a 中文 badge, linking into /zh/.
 */
import { getCollection } from 'astro:content';
import { postSlug } from '../../data/slug';
import Base from '../../layouts/Base.astro';
import WritingCard from '../../components/WritingCard.astro';

const en = await getCollection('writing', (e) => e.data.lang === 'en' && !e.data.draft);
const enSlugs = new Set(en.map(postSlug));
const zhOnly = await getCollection('writing', (e) => e.data.lang === 'zh' && !e.data.draft && !enSlugs.has(postSlug(e)));
const cards = [
  ...en.map((p) => ({ p, href: `/writing/${postSlug(p)}/`, badge: undefined })),
  ...zhOnly.map((p) => ({ p, href: `/zh/writing/${postSlug(p)}/`, badge: '中文' })),
].sort((a, b) => b.p.data.date.valueOf() - a.p.data.date.valueOf());
---

<Base
  title="Writing — 时间观察者"
  description="Science-history essays: the Symmetry and the Monster series, the Euler series, and more."
  lang="en"
  altHref="/zh/writing/"
>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="mb-2 text-3xl font-semibold text-chalk">Writing</h1>
    <p class="mb-8 text-sm text-muted">
      Long-form science history, from Galois to the Monster group. Each essay is available in English and in the original Chinese. Essays that form a series are listed in order on the <a href="/series/" class="text-accent-soft hover:underline">Series</a> page.
    </p>
    <div class="grid gap-4">
      {cards.map(({ p, href, badge }) => (
        <WritingCard
          href={href}
          title={p.data.title}
          date={p.data.date}
          excerpt={p.data.excerpt}
          tags={p.data.tags}
          langBadge={badge}
          lang="en"
        />
      ))}
    </div>
  </main>
</Base>
