---
/**
 * BackgroundEquations — the four equations as COSMIC background.
 *
 * v4 (Yeqiu 2026-07-17): each equation's click-burst enacts ITS OWN physics:
 *   Noether   → a symmetry operation (full rotation) around an unmoving
 *               conservation ring — the thing that stays fixed IS the point;
 *   Path int. → sum over histories: ghost copies fan out along different
 *               paths and interfere back into one;
 *   Dirac     → pair creation: a colour-inverted anti-equation splits off,
 *               returns, annihilates in a flash;
 *   EFE       → spacetime quake + expanding gravitational-wave rings.
 * Ambient motion stays SMIL-driven (Chrome repaint reliability, v3 lesson);
 * hover still freezes a single equation (per-svg pauseAnimations).
 *
 * variant="ambient" (article pages): non-interactive, quieter, fixed — the
 * cosmos sits behind long reads without inviting play (研究 §3.1: 长读面安静).
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  variant?: 'hero' | 'ambient';
  /**
   * Runtime auto-placement (2026-08-02, Yeqiu:「如果每次都要这样调整会非常麻烦
   * 有固定的function来调整吗？」). ON for the hero: the CSS below then only
   * supplies a pre-JS fallback paint, and `placeEquations()` re-solves the real
   * positions from the measured layout on every resize. OFF for `ambient` until
   * it has been checked on the ~20 article pages that share this component.
   */
  autoPlace?: boolean;
}
const { variant = 'hero', autoPlace = variant === 'hero' } = Astro.props;

const eqs = [
  { tex: String.raw`\frac{d}{dt}\!\left(\frac{\partial L}{\partial \dot q}\,\delta q\right)=0`, cls: 'eq-noether' },
  { tex: String.raw`\langle x_f|e^{-iHt/\hbar}|x_i\rangle=\int\!\mathcal{D}[x(t)]\,e^{iS[x]/\hbar}`, cls: 'eq-path' },
  { tex: String.raw`(i\gamma^\mu\partial_\mu-m)\,\psi=0`, cls: 'eq-dirac' },
  { tex: String.raw`G_{\mu\nu}+\Lambda g_{\mu\nu}=\frac{8\pi G}{c^4}T_{\mu\nu}`, cls: 'eq-efe' },
].map((e, i) => ({ ...e, i, html: katex.renderToString(e.tex, { throwOnError: false, output: 'html' }) }));

const uid = variant; // ids must differ if both variants ever co-exist on a page
---

<div
  class:list={['bg-equations', variant, 'pointer-events-none', variant === 'hero' ? 'absolute' : 'fixed', 'inset-0', 'overflow-hidden']}
  data-autoplace={autoPlace ? '' : undefined}
  aria-hidden="true"
>
  {
    eqs.map((e) => (
      <div class:list={['bg-eq', e.cls]} data-eq={e.i}>
        <svg width="0" height="0" class="eq-filter-host" aria-hidden="true">
          <filter id={`eq-warp-${uid}-${e.i}`} x="-25%" y="-60%" width="150%" height="220%">
            <feTurbulence type="fractalNoise" baseFrequency="0.014 0.026" numOctaves="2" seed={e.i * 7 + 1}>
              <animate
                attributeName="baseFrequency"
                dur={`${5.5 + e.i * 1.3}s`}
                values="0.014 0.026;0.026 0.05;0.014 0.026"
                repeatCount="indefinite"
              />
            </feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="12" xChannelSelector="R" yChannelSelector="G">
              <animate attributeName="scale" dur={`${4 + e.i}s`} values="9;16;9" repeatCount="indefinite" />
              <animate class="eq-quake" attributeName="scale" dur="0.9s" values="12;46;6;12" begin="indefinite" />
            </feDisplacementMap>
          </filter>
        </svg>
        <span class="eq-text" style={`filter:url(#eq-warp-${uid}-${e.i})`} set:html={e.html} />
      </div>
    ))
  }
</div>

<script>
  function initEquations() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const root of document.querySelectorAll<HTMLElement>('.bg-equations')) {
      if (root.dataset.eqInit) continue;
      root.dataset.eqInit = '1';
      const interactive = root.classList.contains('hero');
      const wraps = [...root.querySelectorAll<HTMLElement>('.bg-eq')];

      for (const el of wraps) {
        const svg = el.querySelector('svg') as SVGSVGElement | null;
        const text = el.querySelector<HTMLElement>('.eq-text');
        if (!svg || !text) continue;
        if (reduced) {
          svg.pauseAnimations();
          text.style.filter = 'none';
          continue;
        }
        if (!interactive) continue;

        // hover keeps the shimmer running and warms it up (Yeqiu 2026-07-17:
        // 悬停让动画继续 — the freeze is gone; reduced-motion remains the stop).
        el.addEventListener('pointerenter', () => el.classList.add('eq-hot'));
        el.addEventListener('pointerleave', () => el.classList.remove('eq-hot'));
        el.addEventListener('click', () => burst(Number(el.dataset.eq), el, svg, text));
      }

      // park shimmer while the host section is off-screen (WebKit guidance)
      const anchorEl = interactive ? document.querySelector('.hero') : root;
      if (anchorEl && !reduced) {
        new IntersectionObserver(([e]) => {
          for (const el of wraps) {
            const svg = el.querySelector('svg') as SVGSVGElement | null;
            svg && (e.isIntersecting ? svg.unpauseAnimations() : svg.pauseAnimations());
          }
        }).observe(anchorEl);
      }

      if (root.dataset.autoplace !== undefined) {
        const run = () => placeEquations(root);
        run(); // first paint uses the CSS fallback; this replaces it immediately
        // KaTeX metrics change once the maths font lands, which changes the
        // measured widths — re-solve then.
        document.fonts?.ready.then(run).catch(() => {});
        let t = 0;
        const resolve = () => {
          clearTimeout(t);
          t = window.setTimeout(run, 120);
        };
        new ResizeObserver(resolve).observe(root.parentElement ?? root);
        window.addEventListener('resize', resolve);
      }
    }
  }

  /* ------------------------------------------------------------------ *
   * placeEquations — automatic placement.
   *
   * WHY THIS EXISTS (2026-08-02): the four equations used to be positioned by
   * hand-tuned percentage offsets. Percentages are relative to the hero box, so
   * ANY layout change — a shorter hero, an extra line of copy, a new section —
   * silently slid all four onto the text, and each time the fix was to re-measure
   * and re-hardcode. Yeqiu:「如果每次都要这样调整会非常麻烦，有固定的function
   * 来调整吗？」This is that function.
   *
   * It measures where the real content actually is, then drops each equation
   * into free space, preferring the corner it was designed for. If nothing fits
   * (narrow phones) the equation hides itself — no hand-written media query.
   *
   * Deterministic: same layout in ⇒ same positions out. No randomness, so a
   * screenshot diff stays meaningful.
   * ------------------------------------------------------------------ */

  /** the corner each equation was composed for: [right?, bottom?] */
  const EQ_HOME: Record<string, [0 | 1, 0 | 1]> = {
    'eq-noether': [0, 0],
    'eq-efe': [1, 0],
    'eq-dirac': [0, 1],
    'eq-path': [1, 1],
  };

  function placeEquations(root: HTMLElement) {
    const host = root.parentElement;
    if (!host) return;
    const cr = root.getBoundingClientRect();
    if (cr.width < 40 || cr.height < 40) return;

    const PAD = 8; // keep off the container edge
    const GAP = 14; // clear air between an equation and any text
    const STEP = 12; // candidate grid resolution, px

    // Keep-out = every content-bearing element of the host section EXCEPT our
    // own layer. Anything that gains text later is covered without editing this
    // list, because the selector is by role, not by class name.
    const keep: DOMRect[] = [];
    for (const el of host.querySelectorAll<HTMLElement>(
      'h1,h2,h3,h4,p,a,button,label,input,select,textarea,li,figcaption,img,canvas,video,svg,[data-eq-keepout]',
    )) {
      if (root.contains(el)) continue; // our own filter <svg>s live in here
      const r = el.getBoundingClientRect();
      if (r.width < 4 || r.height < 4) continue;
      if (r.right < cr.left || r.left > cr.right || r.bottom < cr.top || r.top > cr.bottom) continue;
      keep.push(r);
    }

    const placed: { x: number; y: number; w: number; h: number }[] = [];

    for (const el of root.querySelectorAll<HTMLElement>('.bg-eq')) {
      // Reset to a known origin and measure the NATURAL size. getBoundingClientRect
      // already accounts for the rotate() each equation carries, and rotation also
      // shifts the visual box away from the offset origin — dx/dy capture that
      // shift so the solved position lands where it is computed to land.
      el.style.display = 'block';
      el.style.right = 'auto';
      el.style.bottom = 'auto';
      el.style.left = '0px';
      el.style.top = '0px';
      const r0 = el.getBoundingClientRect();
      const w = r0.width;
      const h = r0.height;
      const dx = r0.left - cr.left;
      const dy = r0.top - cr.top;
      if (w < 4 || h < 4 || w > cr.width || h > cr.height) {
        el.style.display = 'none';
        continue;
      }

      const cls = [...el.classList].find((c) => c in EQ_HOME) ?? 'eq-noether';
      const [hx, hy] = EQ_HOME[cls];
      const homeX = hx ? cr.width - w - PAD : PAD;
      const homeY = hy ? cr.height - h - PAD : PAD;

      let best: { x: number; y: number; d: number } | null = null;
      for (let y = PAD; y <= cr.height - h - PAD; y += STEP) {
        for (let x = PAD; x <= cr.width - w - PAD; x += STEP) {
          const L = cr.left + x;
          const T = cr.top + y;
          let ok = true;
          for (const k of keep) {
            if (L + w + GAP > k.left && k.right + GAP > L && T + h + GAP > k.top && k.bottom + GAP > T) {
              ok = false;
              break;
            }
          }
          if (ok) {
            for (const p of placed) {
              if (x + w + GAP > p.x && p.x + p.w + GAP > x && y + h + GAP > p.y && p.y + p.h + GAP > y) {
                ok = false;
                break;
              }
            }
          }
          if (!ok) continue;
          const d = Math.hypot(x - homeX, y - homeY); // nearest free spot to its own corner
          if (!best || d < best.d) best = { x, y, d };
        }
      }

      if (!best) {
        el.style.display = 'none'; // no room — better absent than on top of the text
        continue;
      }
      el.style.left = `${Math.round(best.x - dx)}px`;
      el.style.top = `${Math.round(best.y - dy)}px`;
      placed.push({ x: best.x, y: best.y, w, h });
    }
  }

  function ring(el: HTMLElement, delay = 0, size = '34rem') {
    const r = document.createElement('span');
    r.className = 'eq-ring';
    r.style.width = size;
    r.style.height = size;
    el.appendChild(r);
    r.animate(
      [
        { transform: 'translate(-50%,-50%) scale(0.15)', opacity: 0.55 },
        { transform: 'translate(-50%,-50%) scale(1)', opacity: 0 },
      ],
      { duration: 1100, delay, easing: 'cubic-bezier(0.2,0.6,0.3,1)', fill: 'forwards' },
    ).finished.then(() => r.remove());
  }

  function flare(text: HTMLElement, peak = 2.4, dur = 900) {
    text.animate(
      [{ filter: 'brightness(1)' }, { filter: `brightness(${peak})`, offset: 0.18 }, { filter: 'brightness(1)' }],
      { duration: dur, easing: 'ease-out' },
    );
  }

  function ghost(text: HTMLElement): HTMLElement {
    const g = text.cloneNode(true) as HTMLElement;
    g.style.position = 'absolute';
    g.style.left = '0';
    g.style.top = '0';
    g.style.pointerEvents = 'none';
    text.parentElement!.appendChild(g);
    return g;
  }

  function burst(i: number, el: HTMLElement, svg: SVGSVGElement, text: HTMLElement) {
    svg.unpauseAnimations();
    if (i === 0) {
      // NOETHER — perform the symmetry operation; the conservation ring holds still.
      const r = document.createElement('span');
      r.className = 'eq-ring eq-ring-conserved';
      el.appendChild(r);
      r.animate([{ opacity: 0 }, { opacity: 0.5, offset: 0.2 }, { opacity: 0.5, offset: 0.8 }, { opacity: 0 }], {
        duration: 1400,
        easing: 'ease-in-out',
      }).finished.then(() => r.remove());
      text.animate(
        [
          { transform: 'rotate(0deg) scale(1)' },
          { transform: 'rotate(180deg) scale(0.92)', offset: 0.5 },
          { transform: 'rotate(360deg) scale(1)' },
        ],
        { duration: 1300, easing: 'cubic-bezier(0.5,0,0.3,1)' },
      );
      flare(text, 1.8, 1300);
    } else if (i === 1) {
      // PATH INTEGRAL — every history contributes: ghosts fan out, interfere back.
      const paths = [
        { x: -70, y: -46, rot: -10 },
        { x: 60, y: -60, rot: 8 },
        { x: -50, y: 55, rot: 6 },
        { x: 75, y: 40, rot: -7 },
      ];
      for (const pth of paths) {
        const g = ghost(text);
        g.animate(
          [
            { transform: 'translate(0,0) rotate(0deg)', opacity: 0.5 },
            { transform: `translate(${pth.x}px,${pth.y}px) rotate(${pth.rot}deg)`, opacity: 0.28, offset: 0.45 },
            { transform: 'translate(0,0) rotate(0deg)', opacity: 0 },
          ],
          { duration: 1250, easing: 'cubic-bezier(0.4,0,0.4,1)' },
        ).finished.then(() => g.remove());
      }
      flare(text, 2.0, 1250);
    } else if (i === 2) {
      // DIRAC — pair creation: the anti-equation splits off, returns, annihilates.
      const anti = ghost(text);
      anti.style.filter = 'invert(1) hue-rotate(180deg)';
      anti.animate(
        [
          { transform: 'translate(0,0) scaleX(1)', opacity: 0.7 },
          { transform: 'translate(90px,-34px) scaleX(-1)', opacity: 0.55, offset: 0.45 },
          { transform: 'translate(0,0) scaleX(-1)', opacity: 0.9, offset: 0.85 },
          { transform: 'translate(0,0) scaleX(1)', opacity: 0 },
        ],
        { duration: 1200, easing: 'cubic-bezier(0.45,0,0.4,1)' },
      ).finished.then(() => {
        anti.remove();
        flare(text, 3, 500); // annihilation flash
        ring(el, 0, '16rem');
      });
    } else {
      // EFE — spacetime quake + gravitational waves.
      (svg.querySelector('.eq-quake') as any)?.beginElement?.();
      flare(text);
      ring(el, 0);
      ring(el, 180);
    }
  }

  document.addEventListener('astro:page-load', initEquations);
  initEquations();
</script>

<style>
  .bg-eq {
    position: absolute;
    user-select: none;
    animation: eq-emerge 1.8s ease forwards;
    opacity: 0;
  }
  .bg-equations.hero .bg-eq {
    pointer-events: auto; /* hover-glow + click-burst need hit-testing */
    cursor: pointer;
    transition: opacity 0.35s ease;
  }
  .bg-equations.hero .bg-eq.eq-hot {
    opacity: 0.55 !important;
  }
  .bg-eq.eq-hot .eq-text {
    text-shadow:
      0 0 26px color-mix(in srgb, var(--color-accent) 90%, transparent),
      0 0 6px rgba(230, 238, 255, 0.9);
  }
  :global(.eq-ring) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34rem;
    height: 34rem;
    border-radius: 9999px;
    border: 1.5px solid color-mix(in srgb, var(--color-accent-soft) 70%, transparent);
    box-shadow:
      0 0 24px color-mix(in srgb, var(--color-accent) 45%, transparent),
      inset 0 0 18px color-mix(in srgb, var(--color-accent) 30%, transparent);
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.15);
    opacity: 0;
  }
  :global(.eq-ring-conserved) {
    width: 15rem;
    height: 15rem;
    transform: translate(-50%, -50%);
    border-color: color-mix(in srgb, var(--color-gold) 75%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-gold) 40%, transparent);
  }
  .eq-text {
    display: inline-block;
    color: color-mix(in srgb, var(--color-accent-soft) 55%, #e6eeff);
    text-shadow:
      0 0 18px color-mix(in srgb, var(--color-accent) 70%, transparent),
      0 0 4px rgba(230, 238, 255, 0.7);
  }
  html[data-theme='light'] .eq-text {
    color: color-mix(in srgb, var(--color-accent) 70%, #16203a);
    text-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  @keyframes eq-emerge {
    to {
      opacity: 0.34;
    }
  }
  html[data-theme='light'] .bg-eq {
    animation-name: eq-emerge-light;
  }
  @keyframes eq-emerge-light {
    to {
      opacity: 0.22;
    }
  }
  /* ambient variant (article pages): quieter, further back */
  .bg-equations.ambient {
    z-index: -1;
  }
  .bg-equations.ambient .bg-eq {
    animation-name: eq-emerge-ambient;
  }
  @keyframes eq-emerge-ambient {
    to {
      opacity: 0.13;
    }
  }
  html[data-theme='light'] .bg-equations.ambient .bg-eq {
    animation-name: eq-emerge-ambient-light;
  }
  @keyframes eq-emerge-ambient-light {
    to {
      opacity: 0.09;
    }
  }
  .eq-noether {
    top: 6%;
    left: 3%;
    font-size: 1.35rem;
    transform: rotate(-4deg);
    animation-delay: 0.2s;
  }
  .eq-path {
    bottom: 9%;
    right: 2%;
    font-size: 1.5rem;
    transform: rotate(2.5deg);
    animation-delay: 1.1s;
  }
  .eq-dirac {
    bottom: 21%;
    left: 8%;
    font-size: 1.25rem;
    transform: rotate(3deg);
    animation-delay: 0.65s;
  }
  .eq-efe {
    top: 11%;
    right: 6%;
    font-size: 1.4rem;
    transform: rotate(-2deg);
    animation-delay: 1.55s;
  }
  /* --- hero-only repositioning (2026-08-02, Yeqiu:「四个公式好像被遮挡住了，
     手机和网页都是」→「挪位置」not remove) ---------------------------------
     Scoped to .hero on purpose: the four rules above are SHARED with the
     ambient variant on every article page. Editing them in place would move
     the equations on ~20 articles to fix one hero.

     Positions are measured, not guessed. Occupied rectangles inside the
     1152x795 hero box, origin top-left:
        figure   x 479..1128   y  64..654
        eyebrow  x  24..439    y 191..211
        h1       x  24..439    y 227..407
        para     x  24..439    y 431..535
        buttons  x  24..367    y 567..605
        caption  x 479..1019   y 666..705
     The free bands are therefore: above the figure (y 0..64), left of nothing
     below the buttons (y 605..795), and below the caption (y 705..795).
     The four-corner composition survives; only the corners move inward to
     land in those bands.

     Before: efe top 11% sat ON the figure; dirac bottom 21% sat ON the button
     row; path bottom 9% sat ON the caption. Only noether was clear. */
  /* Re-placed 2026-08-02 after the hero was compacted from 792px to 382px and
     then set to a 560px floor. These are PERCENTAGE offsets inside that box, so
     halving its height moved all four — the same rule that was correct at 792
     put Noether on the paragraph and Dirac on the buttons at 382. Measured, not
     re-guessed: at a 560px hero the copy occupies roughly y 56..358, leaving a
     band above it and a ~200px band below. */
  .bg-equations.hero .eq-noether {
    /* NOT top-left any more: the eyebrow line 「时间观察者 · TIMEOBSERVER137」
       now sits there. The copy column is max-w-2xl (672px) inside a 1152px
       hero, so everything past x≈720 is free for the full height — that is
       where this one goes. */
    top: 34%;
    right: 4%;
    /* MUST clear the base rule's `left: 3%`. An absolutely positioned box with
       BOTH left and right resolved is stretched to span them (here: 1072px
       wide), and KaTeX renders its ink at the left edge of that box — so the
       equation stays visually in the top-left and lands on the paragraph while
       the `right` declaration looks like it applied. Measured 2026-08-02:
       rect x178..1250 vs paragraph x168..840 y297..349. */
    left: auto;
  }
  .bg-equations.hero .eq-efe {
    top: 1%;
    right: 6%;
  }
  .bg-equations.hero .eq-dirac {
    bottom: 4%;
    left: 3%;
  }
  .bg-equations.hero .eq-path {
    bottom: 3%;
    right: 2%;
  }

  .bg-equations.ambient .eq-noether {
    top: 12%;
  }
  .bg-equations.ambient .eq-dirac {
    bottom: 12%;
  }
  @media (prefers-reduced-motion: reduce) {
    .bg-eq {
      animation: none;
      opacity: 0.28;
    }
    .bg-equations.ambient .bg-eq {
      opacity: 0.1;
    }
  }
  @media (max-width: 1024px) {
    .eq-path,
    .eq-efe,
    /* noether joins them 2026-08-02: measured at 390 / 600 / 768 / 900 it
       collides with the headline or the paragraph at EVERY width below 1024,
       because top-left stops being empty once the two columns stack. Below
       1024 only Dirac remains, and Dirac is clear at every width tested. One
       faint equation on a phone is an accent; four behind the text is noise. */
    .eq-noether {
      display: none;
    }
    .bg-eq {
      font-size: 1rem;
    }
  }
</style>
