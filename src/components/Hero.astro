---
/**
 * Hero — the A+B synthesis (spec §6: 「虚空当场，他的数学当星」, Yeqiu-approved 2026-07-16).
 *
 * Stage layer: the void — ≥70% of the viewport is empty near-black. No stars,
 * no gradient carpet. Star layer: ONE earned object — the effective-potential
 * contours of Euler's restricted three-body problem (L1–L5), generated from
 * the physics by scripts/design/gen_lagrange_svg.py, drawn once in ≤5s and
 * then still (WCAG 2.2.2-safe). Zero JS: the LCP element is the headline text.
 * Provenance label under the figure is a compositional REQUIREMENT (EN face
 * can't read the zh essay; the label is what makes the star legible as earned).
 */
import lagrangeSvg from '../assets/lagrange-hero.svg?raw';
import BackgroundEquations from './BackgroundEquations.astro';
import FleetGraph from './FleetGraph.astro';

interface Props {
  lang: 'en' | 'zh';
}
const { lang } = Astro.props;
const zh = lang === 'zh';

// Canonical paths, both verified 200 on 2026-08-02. The essay URL used to be
// the bare absolute `.../e10-petersburg-ii-blind-years/`, which only reaches the
// article through a 301 — the real route carries the /zh/writing/ prefix.
// seriesHref matches SymmetrySolids: the series pages exist under /zh/ only, so
// the EN face links there too rather than to a 404.
const essayUrl = '/zh/writing/e10-petersburg-ii-blind-years/';
const seriesHref = '/zh/series/euler/';
---

<!--
  2026-08-02 (Yeqiu:「fleet memory 你怎么放在第二部分？不是说放开头吗？」)
  The headline is about the fleet, so the fleet is what stands behind it. The
  memory graph is now the hero's full-width backdrop rather than a block further
  down, and it is BIGGER here than it was as its own section — moving it into a
  right-hand column would have shrunk it ~40%, which contradicts the other thing
  he asked for the same night (「线条不清晰…把图放大」).
  The Lagrange figure moves below, into the band about the writing — where its
  own caption already pointed.
-->
<!-- Page-level layer, deliberately OUTSIDE .hero (Yeqiu 2026-08-02:「四个公式不是
     这么排的，而是在页面里固定出现在边缘，无论怎么划到哪一页」). Inside .hero it
     scrolled away with the headline; as a sibling it is viewport-fixed and stays at
     the margins for the whole page, which is what the article pages already do. -->
<BackgroundEquations />

<section class="hero relative mx-auto min-h-[560px] max-w-6xl overflow-hidden px-6 pb-6 pt-14">
  <div class="hero-copy relative z-10 max-w-2xl">
    <p data-hero-stagger class="text-sm uppercase tracking-[0.25em] text-muted">时间观察者 · timeobserver137</p>
    <!-- data-split (not data-hero-stagger): SplitText owns this entrance line by
         line. Both would animate the same element and fight. Still zero-JS
         legible — the split only wraps text that is already painted. -->
    <h1 data-split="lines" class="mt-4 text-4xl font-semibold leading-tight text-chalk sm:text-5xl">
      {zh ? '我与我的 AI 伙伴们的故事。' : 'The story of me and my AI partners.'}
    </h1>
    <p data-hero-stagger class="mt-6 leading-relaxed text-muted">
      {zh
        ? '一支 8 智能体舰队、检索管线、和这个亲手写的站点 —— 外加一叠关于对称、群论与欧拉的科学史长文。'
        : 'An eight-agent fleet with a memory architecture, retrieval pipelines, and this hand-built site — plus a shelf of long-form essays on symmetry, group theory, and Euler.'}
    </p>
    <div data-hero-stagger class="mt-8 flex flex-wrap gap-3">
      <a
        href={zh ? '/zh/projects/' : '/projects/'}
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-soft"
        >{zh ? '看项目' : 'View projects'}</a
      >
      <a
        href={zh ? '/zh/writing/' : '/writing/'}
        class="rounded-md border border-line px-4 py-2 text-sm text-ink transition-colors hover:border-accent-soft"
        >{zh ? '读文章' : 'Read writing'}</a
      >
      <a
        href="https://github.com/stars1210JasonHe"
        class="rounded-md border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-accent-soft hover:text-ink"
        >GitHub</a
      >
    </div>
  </div>

</section>

<!-- The graph is the SUBJECT, not wallpaper (Yeqiu 2026-08-02:「为什么做成背景？」).
     He is right: it is 1,108 real memories and 1,474 real citations, and putting it
     behind the headline with a scrim over half of it said "look at this" and "you
     may not see this" at the same time. The headline block above is now compact so
     this still lands in the first screen — what he objected to originally was having
     to scroll to find it, not its being its own element. -->
<section class="fleet-band mx-auto max-w-6xl px-6 pb-4">
  <FleetGraph lang={lang} variant="hero" />
</section>

<!-- Series block, house style. It matches SymmetrySolids deliberately (Yeqiu
     2026-08-02:「参考我和escher做的euler系列，把名字和格式做好」): thematic eyebrow
     -> figure -> a caption that names the series as it is registered and offers
     episode one. The series is 《欧拉》 in src/data/series.ts — not a title I get
     to invent per page — and the earlier heading「欧拉与三体问题」named a topic
     that no series is called. -->
<section class="orrery-band mx-auto max-w-6xl px-6 pb-16" data-reveal>
  <p class="text-center text-sm uppercase tracking-[0.25em] text-muted">
    {zh ? '三体的平衡点' : 'Where three bodies balance'}
  </p>
  <figure class="orrery mx-auto mt-6 w-full max-w-[440px] text-center">
    <!--
      Pause first in source order so the CSS-only `:checked ~` can reach the
      figure. WCAG 2.2.2 requires a mechanism to stop motion that runs past 5s,
      and this rotation runs forever. A checkbox keeps that mechanism working
      with JavaScript switched off — the same property the rest of this figure
      already has.
    -->
    <input type="checkbox" id="orrery-pause" class="orrery-pause peer sr-only" />
    <div class="lagrange w-full" set:html={lagrangeSvg} />
    <figcaption class="mx-auto mt-3 max-w-[540px] text-xs leading-relaxed text-faint">
      {zh ? (
        <>限制性三体问题的有效势等势线，L<sub>1</sub>–L<sub>5</sub> —— 欧拉先找到了共线的那三个。出自我的文章<a class="text-muted underline decoration-line underline-offset-2 transition-colors hover:text-ink" href={essayUrl}>《失明的十七年里，欧拉做了什么》</a>。</>
      ) : (
        <>Effective-potential contours of the restricted three-body problem, L<sub>1</sub>–L<sub>5</sub> — Euler found the collinear three first. From my essay <a class="text-muted underline decoration-line underline-offset-2 transition-colors hover:text-ink" href={essayUrl}>on Euler's blind years</a>.</>
      )}
    </figcaption>
    <label for="orrery-pause" class="orrery-pause-btn mt-2 inline-block cursor-pointer text-xs text-faint underline decoration-line underline-offset-2 transition-colors hover:text-muted">
      <span class="when-running">{zh ? '暂停旋转' : 'Pause rotation'}</span>
      <span class="when-paused">{zh ? '继续旋转' : 'Resume rotation'}</span>
    </label>
  </figure>
  <p class="mx-auto mt-6 max-w-2xl text-center leading-relaxed text-muted">
    {zh ? (
      <>{'三个天体互相拉扯，方程解不出来 —— 欧拉却找出了五个平衡点里共线的三个。这样的问题，他一辈子解了几十个，其中十七年是在失明中做的。'}
      <a class="text-accent-soft underline underline-offset-2" href={seriesHref}>读《欧拉》系列 →</a></>
    ) : (
      <>Three bodies pull on each other and the equations have no closed solution — yet Euler
      found three of the five points where the pull cancels. He solved problems like this for a
      lifetime, seventeen years of it blind.
      <a class="text-accent-soft underline underline-offset-2" href={seriesHref}>Read the Euler series →</a></>
    )}
  </p>
</section>

<style>
  /* The graph lives in its own band now, so it needs a height of its own:
     .fg-stage inside it is `absolute inset-0`, which collapses to nothing
     without one. Measured when this was missing: the band rendered 16px tall
     and the canvas fell back to the window size (1440x900). */
  .fleet-band :global(.fg-hero) {
    position: relative;
    height: 560px;
    opacity: 1;
  }
  @media (max-width: 900px) {
    .fleet-band :global(.fg-hero) {
      height: 380px;
    }
  }

  /* Draw-once-then-still: total ≈ 4.4s < 5s (WCAG 2.2.2 threshold). Zero JS. */
  .lagrange :global(svg) {
    width: 100%;
    height: auto;
  }
  .lagrange :global(.contours path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--i, 0) * 0.11s);
  }
  .lagrange :global(.sun),
  .lagrange :global(.planet),
  .lagrange :global(.lpoints) {
    opacity: 0;
    animation: appear 0.7s ease 3.7s forwards;
  }

  /* --- the two primaries read as BODIES, not dots (Yeqiu 2026-08-02:
     「行星小了一点看上去不够闪光」) -----------------------------------------
     Measured before changing anything: at 1440 the sun was 15px across and the
     planet 7.5px; at 390 they were 8px and 4px. A four-pixel planet is not a
     planet, it is a rendering artifact.

     Enlarging them is not a physics lie. The contour geometry and the L-point
     POSITIONS are computed and must not move — but these two discs were always
     symbolic: at this scale a true-to-size primary would be well under one
     pixel. So radius and brightness are free; position is not.

     r is set in CSS rather than the generator, following the .lp4 precedent
     below — it keeps the change out of gen_lagrange_svg.py, which Fermat is
     also editing. */
  .lagrange :global(.sun) {
    r: 17;
    filter:
      drop-shadow(0 0 4px rgba(221, 162, 91, 0.95))
      drop-shadow(0 0 14px rgba(221, 162, 91, 0.55))
      drop-shadow(0 0 34px rgba(221, 162, 91, 0.28));
  }
  .lagrange :global(.planet) {
    r: 9;
    filter:
      drop-shadow(0 0 3px rgba(125, 179, 224, 0.95))
      drop-shadow(0 0 10px rgba(125, 179, 224, 0.55))
      drop-shadow(0 0 24px rgba(125, 179, 224, 0.3));
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  /* after the construction settles, the system LIVES: L-points breathe
     (opacity-only — outside WCAG 2.2.2's motion definition) */
  .lagrange :global(.lpoints) {
    animation:
      appear 0.7s ease 3.7s forwards,
      lp-breathe 5.5s ease-in-out 6s infinite;
  }
  @keyframes lp-breathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  /* --- the frame turns (R-62 item 4, Yeqiu: 「让人能够知道这是三体运动」) ----
     These contours are drawn in the ROTATING frame of the two primaries. Seen
     from an inertial observer the whole picture — contours, both bodies, all
     five L points — turns rigidly about the barycentre. So this is not a spin
     effect applied to a static image; the turning IS the physics.

     The barycentre is the centre of the viewBox by construction: the bodies sit
     at (-MU, 0) and (1-MU, 0), so the origin is the centre of mass, and the
     generator now pads the viewBox to 0 -61 860 782 so that centre lands at
     (430, 330) = 50% 50%. The padding is measured, not chosen: over all 5498
     emitted path coordinates the farthest is 390.5px from the barycentre, and
     391 > 390.5 on every side, so no angle clips.

     Starts at 4.6s — after the 4.4s construction finishes. Letting it turn
     during the draw would bury the thing the draw exists to show.

     Rotate the inner group, never the svg element. Rotating the element turns
     its CSS box, whose bounding box grows with the angle — measured at 660px
     wide it swept 172px into the headline column. Turning an inner group leaves
     the element's box where it is, and the padding above guarantees the content
     stays inside the viewBox at every angle. */
  .lagrange :global(.orrery-rot) {
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: orrery-spin 52s linear 4.6s infinite;
  }
  @keyframes orrery-spin {
    to {
      transform: rotate(360deg);
    }
  }
  /* The L labels ride along but stay upright. They are annotation, not part of
     the system — a label that turns with the frame spends half the cycle
     upside down, which costs legibility and buys no physics. Same duration,
     same delay, same linear timing, opposite direction: they cancel exactly,
     so each label counter-turns about its own centre while its marker orbits. */
  .lagrange :global(.lpoints text) {
    transform-box: fill-box;
    transform-origin: center;
    animation: orrery-counter 52s linear 4.6s infinite;
  }
  @keyframes orrery-counter {
    to {
      transform: rotate(-360deg);
    }
  }
  /* CSS-only pause (WCAG 2.2.2). Works with JS off. */
  .orrery-pause:checked ~ .lagrange :global(.orrery-rot),
  .orrery-pause:checked ~ .lagrange :global(.lpoints text) {
    animation-play-state: paused;
  }
  .orrery-pause-btn .when-paused {
    display: none;
  }
  .orrery-pause:checked ~ .orrery-pause-btn .when-running {
    display: none;
  }
  .orrery-pause:checked ~ .orrery-pause-btn .when-paused {
    display: inline;
  }
  .orrery-pause:focus-visible ~ .orrery-pause-btn {
    outline: 2px solid var(--color-accent-soft, #7db3e0);
    outline-offset: 3px;
  }

  /* Brighter, heavier lines — the figure now carries the composition (item 4 A). */
  .lagrange :global(.contours) {
    opacity: 1;
  }
  .lagrange :global(.contours path) {
    stroke-width: 1.5;
  }

  /* L4 WAS enlarged and given a halo so it would read as the third body — the
     massless test particle keeping station with the two primaries. Reverted
     2026-08-02.

     Two reasons, and the second is the real one:
     1. Yeqiu asked「那个在运动的小圆点是第三颗星？」— the intent did not land.
        He saw an emphasised dot and had to ask what it was. An element that
        needs to be explained is not carrying its meaning.
     2. He then decided 小星不做. Once there is no third body in the picture,
        L4 has no claim to be bigger than L1, L2, L3, L5 — they are five points
        of the same kind. Keeping the halo would be emphasis without a reason,
        which is the definition of decoration under this project's gate.

     Honesty footnote that also argued against it: the figure is drawn at a mass
     ratio of 0.15, and the triangular points are only stable below about
     0.0385 (Routh). So even a body parked at L4 would not stay there in THIS
     configuration — the emphasis was pointing at something the drawing does not
     actually support. */

  /* --- phone: everything inside the SVG scales with the viewBox, and text has
     a legibility floor that a scale factor does not respect -----------------
     Yeqiu 2026-08-02: 「手机上 L1-L5 飘了，另外这颗小星也不太清楚」.

     Measured before changing anything: the labels are NOT detaching — across a
     62 degree turn each stayed 8-11px from its marker at a screen angle of
     exactly 0. The problem is size. At 390 the figure renders 342px wide
     (scale 0.398), so a label is 9x10px against 16x18px at 1440, and the
     markers are 2.5px. At that size a label cannot be read as a label; it
     reads as a speck drifting around the picture, which is what "飘" describes.

     So this is a floor, not a redesign: bump the user-unit sizes on small
     screens so the RENDERED size lands near the desktop one. The tspan
     subscript carries its own font-size attribute and has to be lifted with
     the group or the digit stays tiny while the L grows. */
  @media (max-width: 767px) {
    .lagrange :global(.lpoints) {
      font-size: 34px;
    }
    .lagrange :global(.lpoints tspan) {
      font-size: 23px;
    }
    .lagrange :global(.lp) {
      r: 5;
    }
    .lagrange :global(.sun) {
      r: 24;
    }
    .lagrange :global(.planet) {
      r: 13;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lagrange :global(.contours path),
    .lagrange :global(.sun),
    .lagrange :global(.planet),
    .lagrange :global(.lpoints) {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
    /* fully still — the pre-item-4 behaviour, kept exactly */
    .lagrange :global(.orrery-rot),
    .lagrange :global(.lpoints text) {
      animation: none;
      transform: none;
    }
    /* nothing to pause, so do not offer a control that does nothing */
    .orrery-pause-btn {
      display: none;
    }
  }
</style>

<script>
  // Test particle coasting along an equipotential (Yeqiu 2026-07-17: 进站动画
  // 多一点). SMIL animateMotion — browser-invalidated, the v3 lesson. Enters
  // after the draw-on finishes: construction first, then the system lives.
  const __initOnLoad = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const svg = document.querySelector<SVGSVGElement>('.lagrange svg');
    if (!svg || svg.querySelector('.orbiter')) return;
    const paths = [...svg.querySelectorAll<SVGPathElement>('.contours path')];
    if (!paths.length) return;
    const sorted = paths
      .map((el) => ({ el, len: el.getTotalLength() }))
      .sort((a, b) => a.len - b.len);
    const orbit = sorted[Math.floor(sorted.length * 0.45)].el; // a mid ring
    orbit.id = 'orbit-path';
    const NS = 'http://www.w3.org/2000/svg';
    const dot = document.createElementNS(NS, 'circle');
    dot.setAttribute('r', '2.4');
    dot.setAttribute('fill', '#dda25b');
    dot.setAttribute('class', 'orbiter');
    dot.setAttribute('opacity', '0');
    const fade = document.createElementNS(NS, 'animate');
    fade.setAttribute('attributeName', 'opacity');
    fade.setAttribute('values', '0;0.9');
    fade.setAttribute('dur', '1.2s');
    fade.setAttribute('begin', '5s');
    fade.setAttribute('fill', 'freeze');
    const motion = document.createElementNS(NS, 'animateMotion');
    motion.setAttribute('dur', '30s');
    motion.setAttribute('repeatCount', 'indefinite');
    motion.setAttribute('rotate', '0');
    const mpath = document.createElementNS(NS, 'mpath');
    mpath.setAttribute('href', '#orbit-path');
    motion.appendChild(mpath);
    dot.appendChild(fade);
    dot.appendChild(motion);
    svg.appendChild(dot);
  };
  // register for future swaps AND run now — if this script was swapped in
  // by ClientRouter, this navigation's astro:page-load has already fired
  document.addEventListener('astro:page-load', __initOnLoad);
  __initOnLoad();
</script>
