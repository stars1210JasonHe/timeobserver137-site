---
/**
 * FleetGraph — the fleet's memory, drawn from the fleet's memory.
 *
 * Yeqiu 2026-08-02: the headline says "the story of me and my AI partners" and
 * the hero showed Euler's three-body contours — two different questions. This
 * answers the headline's one, and answers it with the actual data rather than a
 * constellation someone drew.
 *
 * Every dot is one real memory anchor. Every line is one real `[[id]]`
 * cross-reference between two anchors. Positions come from the layout the fleet
 * tooling already computes; nothing here is arranged for looks.
 *
 * ENCODING (deliberately NOT one hue per agent — the source graph used eight
 * bright colours and that is exactly why it read as noise against a site whose
 * whole palette is near-black + gold + blue):
 *   position  → which agent (the clusters are already separated in space, and
 *               space is a stronger identity channel than hue)
 *   gold      → anchors, and links inside one agent's own memory
 *   blue      → the 119 links that CROSS agents (8.1% of 1474). That minority
 *               is the whole point: it is the fleet citing itself. Buried in
 *               grey it is invisible; pulled out in the site's second colour,
 *               "these eight reference each other" becomes something you see
 *               instead of something the caption claims.
 *   type      → the eight names, in ink tokens, never in a series colour.
 *
 * The counts printed below MUST match the file actually loaded — there are two
 * generators with two edge-parsing rules (markdown 1106/1652, SQLite 1108/1474)
 * and quoting one while rendering the other is the easiest lie to tell here.
 * (Neo's warning, 2026-08-02.)
 *
 * Data: src/data/fleet-graph-core.json, exported by
 * neo/tools/wiki_graph_export_public.py. It carries no anchor ids, no bodies
 * and no source paths — the exporter refuses to write the file if any text
 * field survives, so this is enforced upstream rather than trusted here.
 */
import graph from '../data/fleet-graph-core.json';

interface Props {
  lang: 'en' | 'zh';
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const nodeCount = graph.nodes.length;
const edgeCount = graph.edges.length;
const clusterCount = graph.clusters.length;
const crossCount = graph.edges.filter(
  ([a, b]: number[]) => graph.nodes[a][2] !== graph.nodes[b][2],
).length;

const fmt = (n: number) => n.toLocaleString('en-US');
---

<section class="fleet-graph mx-auto max-w-6xl px-6 py-14" data-reveal>
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-2xl font-semibold text-chalk">{zh ? '这支舰队的记忆' : "The fleet's memory"}</h2>
    <a
      href={zh ? '/zh/projects/openclaw-fleet/' : '/projects/openclaw-fleet/'}
      class="shrink-0 text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink"
      >{zh ? '认识他们 →' : 'Meet them →'}</a
    >
  </div>

  <figure class="mt-6">
    <div class="fg-stage relative w-full">
      <canvas class="fg-canvas block w-full" role="img" aria-label={zh
        ? `${clusterCount} 个智能体的记忆图：${fmt(nodeCount)} 条互相引用的记忆，${fmt(edgeCount)} 条引用`
        : `Memory graph of ${clusterCount} agents: ${fmt(nodeCount)} interlinked memories, ${fmt(edgeCount)} references`}></canvas>
    </div>
    <button
      type="button"
      class="fg-pause mt-3 text-xs text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink"
      aria-pressed="false"
      data-pause={zh ? '暂停动画' : 'Pause animation'}
      data-resume={zh ? '继续动画' : 'Resume animation'}
      >{zh ? '暂停动画' : 'Pause animation'}</button
    >
    <figcaption class="mt-4 max-w-3xl text-xs leading-relaxed text-faint">
      {zh ? (
        <>
          每一个点是一条真实的记忆，每一条线是一条真实的引用。八簇 = 八个智能体，位置由链接结构算出，不是排布出来的。
          <span class="text-muted"> {fmt(nodeCount)} 条互相引用的记忆 · {fmt(edgeCount)} 条引用，其中 {fmt(crossCount)} 条跨越智能体（蓝色）</span>
          —— 那 {fmt(crossCount)} 条是这支舰队在引用它自己。
        </>
      ) : (
        <>
          Every dot is one real memory; every line one real citation between two of them. Eight clusters, eight agents;
          the positions come from the link structure, not from an arrangement.
          <span class="text-muted"> {fmt(nodeCount)} interlinked memories · {fmt(edgeCount)} citations, {fmt(crossCount)} of them across agents (blue)</span>
          — those {fmt(crossCount)} are the fleet citing itself.
        </>
      )}
    </figcaption>
  </figure>
</section>

<script define:vars={{ graph }}>
  (() => {
    const GOLD = '221, 162, 91';
    const BLUE = '125, 179, 224';
    // Eight categorical slots, dark steps, from the validated reference palette.
    // Verified with the palette validator rather than by eye:
    //   adjacent pairlist  → ALL PASS (lightness band, chroma, CVD 8.4, normal 19.3, contrast)
    //   all-pairs pairlist → FAILS two pairs (#d55181↔#199e70 deutan 1.6,
    //                        #e66767↔#d95926 normal 7.1) — and per the reference,
    //                        NO ordering of eight clears all-pairs; the documented
    //                        cap for that pairlist is three slots.
    // Shipped anyway because identity here is not colour-alone: every cluster is
    // spatially separated AND directly labelled, which is exactly the relief the
    // reference prescribes. Colour reinforces identity; it does not carry it.
    const SLOTS = ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300', '#9085e9', '#e66767'];
    const hexRgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)].join(', ');

    function draw(canvas) {
      if (canvas.dataset.fgWired) return;
      canvas.dataset.fgWired = '1';

      const nodes = graph.nodes;
      const edges = graph.edges;
      const centers = graph.centers;
      const clusters = graph.clusters;

      const xs = nodes.map((n) => n[0]);
      const ys = nodes.map((n) => n[1]);
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);

      const cross = [];
      const inner = [];
      for (const [a, b] of edges) (nodes[a][2] === nodes[b][2] ? inner : cross).push([a, b]);

      const ctxRef = { c: canvas.getContext('2d') };
      const ctx = new Proxy({}, {
        get: (_, k) => { const v = ctxRef.c[k]; return typeof v === 'function' ? v.bind(ctxRef.c) : v; },
        set: (_, k, v) => { ctxRef.c[k] = v; return true; },
      });
      let W = 0, H = 0, sc = 1, ox = 0, oy = 0, dpr = 1;

      function layout() {
        const rect = canvas.parentElement.getBoundingClientRect();
        // squarish, capped so it never eats a whole phone screen
        W = Math.max(280, Math.round(rect.width));
        // the data is near-square (3298 x 3116), so HEIGHT was the binding
        // constraint: at W=1104 the old 560 cap drew the graph only ~475px
        // across inside a 1104px column. Raising the cap enlarges it ~44%
        // without touching the layout. (Yeqiu:「线条不清晰…把图放大」)
        H = Math.round(Math.min(W * 0.95, 780));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const pad = 64;
        sc = Math.min((W - pad * 2) / (maxX - minX), (H - pad * 2) / (maxY - minY));
        ox = (W - (maxX - minX) * sc) / 2 - minX * sc;
        oy = (H - (maxY - minY) * sc) / 2 - minY * sc;
      }
      const px = (n) => n[0] * sc + ox;
      const py = (n) => n[1] * sc + oy;

      // p = 0..1 entrance progress. Order: inner links, then nodes, then the
      // cross-agent links last — the rare thing arrives after the common one,
      // so the eye has something to land on when it appears.
      const CRGB = SLOTS.map(hexRgb);
      function render(p) {
        ctx.clearRect(0, 0, W, H);
        const eInner = Math.min(1, p / 0.5);
        const eNode = Math.min(1, Math.max(0, (p - 0.15) / 0.5));
        const eCross = Math.min(1, Math.max(0, (p - 0.62) / 0.38));

        // within-agent links, in that agent's own colour
        ctx.lineWidth = 0.75;
        for (let c = 0; c < clusters.length; c++) {
          ctx.strokeStyle = `rgba(${CRGB[c % CRGB.length]}, ${0.3 * eInner})`;
          ctx.beginPath();
          for (const [a, b] of inner) {
            if (nodes[a][2] !== c) continue;
            ctx.moveTo(px(nodes[a]), py(nodes[a]));
            ctx.lineTo(px(nodes[b]), py(nodes[b]));
          }
          ctx.stroke();
        }

        const r = 2.2 * eNode;
        if (r > 0.05) {
          ctx.shadowBlur = 5;
          for (let c = 0; c < clusters.length; c++) {
            const rgb = CRGB[c % CRGB.length];
            ctx.fillStyle = `rgba(${rgb}, ${0.92 * eNode})`;
            ctx.shadowColor = `rgba(${rgb}, 0.55)`;
            ctx.beginPath();
            for (const n of nodes) {
              if (n[2] !== c) continue;
              ctx.moveTo(px(n) + r, py(n));
              ctx.arc(px(n), py(n), r, 0, 6.284);
            }
            ctx.fill();
          }
          ctx.shadowBlur = 0;
        }

        // the 119 that cross agents stay in one neutral colour on purpose:
        // they belong to no single agent, and colouring them by either end
        // would assert an ownership the citation does not have
        if (eCross > 0) {
          ctx.lineWidth = 0.85;
          ctx.strokeStyle = `rgba(${BLUE}, ${0.38 * eCross})`;
          ctx.beginPath();
          for (const [a, b] of cross) {
            ctx.moveTo(px(nodes[a]), py(nodes[a]));
            ctx.lineTo(px(nodes[b]), py(nodes[b]));
          }
          ctx.stroke();
        }

        ctx.font = '500 12.5px ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.lineJoin = 'round';
        for (let c = 0; c < clusters.length; c++) {
          const ctr = centers[clusters[c]];
          if (!ctr) continue;
          const L = Math.hypot(ctr[0], ctr[1]) || 1;
          // 380 not 620: cluster centres sit at radius 1150 and the data only
          // reaches ~1709, so a 620 push put abel and fermat outside the fitted
          // box and the canvas clipped them once the graph was enlarged.
          const x = (ctr[0] + (ctr[0] / L) * 380) * sc + ox;
          const y = (ctr[1] + (ctr[1] / L) * 380) * sc + oy + 4;
          ctx.lineWidth = 3;
          ctx.strokeStyle = `rgba(9, 14, 26, ${0.85 * eNode})`;
          ctx.strokeText(clusters[c], x, y);
          ctx.fillStyle = `rgba(${CRGB[c % CRGB.length]}, ${0.95 * eNode})`;
          ctx.fillText(clusters[c], x, y);
        }
      }

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      layout();

      // --- after the entrance, the graph keeps living -----------------------
      // Yeqiu:「其他都是动态特效，这个固定着有一点死板」. But the motion has to
      // MEAN something or it is decoration under this project's gate, so it is
      // not drift or spin: pulses travel along the cross-agent citations. That
      // is the act the picture is about — one agent reaching into another's
      // memory. Only a handful are lit at a time, so the 119 stay a sparse
      // event rather than becoming a moving cage.
      //
      // The 1108 nodes and 1355 within-agent links are painted ONCE into an
      // offscreen canvas and blitted each frame; only the pulses are redrawn.
      // Repainting everything per frame is what would make this drop frames.
      let base = null;
      function cacheBase() {
        base = document.createElement('canvas');
        base.width = canvas.width;
        base.height = canvas.height;
        const bx = base.getContext('2d');
        bx.setTransform(dpr, 0, 0, dpr, 0, 0);
        renderTo(bx, 1);
      }
      function renderTo(target, p) {
        const prev = ctx;
        // render() closes over ctx, so swap it for the duration
        // (kept explicit rather than clever: this is the only place it happens)
        ctxRef.c = target;
        render(p);
        ctxRef.c = prev;
      }

      const LIVE = 7; // pulses in flight
      let pulses = [];
      const seedPulse = () => ({
        e: cross[(Math.random() * cross.length) | 0],
        t: -Math.random() * 0.6,
        sp: 0.14 + Math.random() * 0.18,
      });

      let paused = false;
      let rafId = 0;
      function tick(now) {
        rafId = requestAnimationFrame(tick);
        if (paused || !base) return;
        ctx.clearRect(0, 0, W, H);
        ctx.drawImage(base, 0, 0, W, H);
        for (const pu of pulses) {
          pu.t += pu.sp * 0.016;
          if (pu.t > 1.25) Object.assign(pu, seedPulse());
          if (pu.t < 0 || pu.t > 1) continue;
          const [a, b] = pu.e;
          const x = px(nodes[a]) + (px(nodes[b]) - px(nodes[a])) * pu.t;
          const y = py(nodes[a]) + (py(nodes[b]) - py(nodes[a])) * pu.t;
          const fade = Math.sin(Math.PI * pu.t);
          ctx.fillStyle = `rgba(${BLUE}, ${0.9 * fade})`;
          ctx.shadowColor = `rgba(${BLUE}, 0.9)`;
          ctx.shadowBlur = 8;
          ctx.beginPath();
          ctx.arc(x, y, 2.1, 0, 6.284);
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      if (reduced) {
        render(1);
      } else {
        let started = false;
        const run = () => {
          if (started) return;
          started = true;
          const t0 = performance.now();
          const DUR = 2200;
          const step = (t) => {
            const raw = Math.min(1, (t - t0) / DUR);
            render(1 - Math.pow(1 - raw, 3));
            if (raw < 1) requestAnimationFrame(step);
            else {
              cacheBase();
              pulses = Array.from({ length: LIVE }, seedPulse);
              rafId = requestAnimationFrame(tick);
            }
          };
          requestAnimationFrame(step);
        };
        render(0);
        new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) if (e.isIntersecting) { run(); obs.disconnect(); }
          },
          { threshold: 0.25 },
        ).observe(canvas);

        // WCAG 2.2.2: anything moving past five seconds needs a way to stop it.
        const btn = document.querySelector('.fg-pause');
        if (btn) {
          btn.addEventListener('click', () => {
            paused = !paused;
            btn.textContent = paused ? btn.dataset.resume : btn.dataset.pause;
            btn.setAttribute('aria-pressed', String(paused));
          });
        }
      }

      let rt;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = setTimeout(() => { layout(); render(1); }, 150);
      });
    }

    const init = () => document.querySelectorAll('.fg-canvas').forEach(draw);
    document.addEventListener('astro:page-load', init);
    init();
  })();
</script>
